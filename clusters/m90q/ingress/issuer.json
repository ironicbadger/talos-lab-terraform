{
  "apiVersion": "cert-manager.io/v1",
  "kind": "ClusterIssuer",
  "metadata": {
    "name": "letsencrypt-cloudflare"
  },
  "spec": {
    "acme": {
      "email": "alexktz@gmail.com",
      "server": "https://acme-v02.api.letsencrypt.org/directory",
      "privateKeySecretRef": {
        "name": "letsencrypt-cloudflare-account"
      },
      "solvers": [
        {
          "selector": {
            "dnsZones": [
              "ktz.me"
            ]
          },
          "dns01": {
            "cloudflare": {
              "apiTokenSecretRef": {
                "name": "cloudflare-dns",
                "key": "api-token"
              }
            }
          }
        }
      ]
    }
  }
}
