{
  "apiVersion": "helm.toolkit.fluxcd.io/v2",
  "kind": "HelmRelease",
  "metadata": {
    "name": "tailscale-operator",
    "namespace": "tailscale"
  },
  "spec": {
    "releaseName": "tailscale-operator",
    "interval": "30m",
    "timeout": "5m",
    "chart": {
      "spec": {
        "chart": "tailscale-operator",
        "version": "1.102.3",
        "sourceRef": {
          "kind": "HelmRepository",
          "name": "tailscale",
          "namespace": "flux-system"
        }
      }
    },
    "install": {
      "remediation": {
        "retries": 3
      }
    },
    "upgrade": {
      "remediation": {
        "retries": 3
      }
    },
    "values": {
      "operatorConfig": {
        "hostname": "m90q-ts-operator",
        "defaultTags": [
          "tag:k8s-operator",
          "tag:k8s"
        ]
      },
      "proxyConfig": {
        "defaultTags": "tag:k8s"
      },
      "apiServerProxyConfig": {
        "mode": "true",
        "allowImpersonation": "true"
      }
    }
  }
}
